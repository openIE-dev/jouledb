<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>OpenIE.JouleDB</PackageId>
    <Version>0.10.0</Version>
    <Authors>Open Interface Engineering, Inc.</Authors>
    <Description>In-tree .NET / C# client SDK for JouleDB v0.10.0 (pre-1.0 preview) — SQL, Amorphic Continuum, Live Migration, Security Control Self-Tests, and Energy Receipts.</Description>
    <PackageLicenseExpression>Apache-2.0 OR MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/openIE-dev/jouledb</RepositoryUrl>
  </PropertyGroup>
</Project>
